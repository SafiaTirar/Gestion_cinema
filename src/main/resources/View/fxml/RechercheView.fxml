<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ma.cinefx.Controller.RechercheController"
            prefHeight="520.0" prefWidth="920.0">

    <children>
        <VBox spacing="10"
              AnchorPane.topAnchor="12" AnchorPane.leftAnchor="12"
              AnchorPane.rightAnchor="12" AnchorPane.bottomAnchor="12">

            <Label text="Recherche des séances"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <TextField fx:id="txtFilm" promptText="Film (titre)..." prefWidth="240"/>
                <TextField fx:id="txtGenre" promptText="Genre (ex: action)..." prefWidth="200"/>
                <DatePicker fx:id="dpDate" promptText="Date"/>
                <Button text="Rechercher" onAction="#onSearch"/>
                <Button text="Reset" onAction="#onReset"/>
                <Button text="Retour" onAction="#onBack"/>
            </HBox>

            <TableView fx:id="tableSeances" prefHeight="420">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colFilm" text="Film" prefWidth="220"/>
                    <TableColumn fx:id="colGenre" text="Genre" prefWidth="150"/>
                    <TableColumn fx:id="colSalle" text="Salle" prefWidth="140"/>
                    <TableColumn fx:id="colDateHeure" text="Date/Heure" prefWidth="170"/>
                    <TableColumn fx:id="colTarif" text="Tarif" prefWidth="140"/>
                </columns>
            </TableView>

            <Label fx:id="lblInfo" text=""/>
        </VBox>
    </children>
</AnchorPane>
